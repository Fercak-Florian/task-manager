{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center">
        <form method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div>{{ app.user.firstName }}, bienvenue sur task Manager</div>
            {% else %}
                <div class="d-flex flex-column align-items-center">
                    <h1 class="fs-1 fw-bold mt-3">Bienvenue sur Task Manager</h1>
                    <div class="fs-6">Vous n'avez pas de compte ? <a href="{{ path("app_register") }}">Inscrivez-vous</a></div>
                </div>
                <label for="username" class="fw-bold mt-3">Entrez votre adresse mail</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control mb-3" autocomplete="email" required autofocus>
                <label for="password" class="fw-bold">Entrez votre mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control mb-3" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {#
                Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                See https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Remember me</label>
                </div>
                #}
                <div class="d-grid gap-2">
                    <button class="btn btn-lg btn-primary" type="submit">
                        Me connecter
                    </button>
                </div>
            {% endif %}
        </form>
    </div>
{% endblock %}
